#!/usr/bin/env bash
#
# Build the session's kubeconfig from the published CIRRUS one, or the user's.
#
# The current CIRRUS kubeconfig is fetched into ~/.kube/cirrus-config first (see
# step 0). Whichever source is then chosen is read here and never written: every
# mutation lands on a copy at $KUBECONFIG. ~/.kube/config in particular is shared
# with the user's Casper and Derecho sessions and is never touched. The copy is
# ephemeral on purpose -- it is derived state, rebuilt at every session launch,
# so it always reflects the current source config.
#
# Run by the entrypoint, and safe to re-run by hand mid-session.

set -euo pipefail

PROG="cirrus-kubeconfig-init"
DOCS_URL="https://ncar-hpc-docs.readthedocs.io/en/latest/compute-systems/cirrus/guides/10-kubectl/kubectl/"

# stderr, so that running this from the entrypoint cannot inject lines into the
# stdout of whatever the session actually launched.
log()  { printf '%s: %s\n' "$PROG" "$*" >&2; }
warn() { printf '%s: WARNING: %s\n' "$PROG" "$*" >&2; }
die()  { printf '%s: ERROR: %s\n' "$PROG" "$1" >&2; shift; for l in "$@"; do printf '  %s\n' "$l" >&2; done; exit 1; }

STATE_DIR="${CIRRUS_STATE_DIR:-/tmp/cirrus}"
# Two kubeconfigs can live in a GLADE home and they are not interchangeable:
#
#   ~/.kube/cirrus-config  the container-friendly one -- mlc1 + nwc1, Azure
#                          kubelogin, CA embedded as certificate-authority-data.
#                          Works in a pod, which is why it is preferred here.
#   ~/.kube/config         the one CIRRUS issues for Casper and Derecho, which
#                          refers to /etc/pki/tls/certs/cirrus-ca.crt and
#                          /opt/ncar/sbin/get-cirrus-token.sh by absolute path.
#                          Those exist on those hosts and in no image.
#
# So: an explicit CIRRUS_KUBECONFIG_SRC wins, otherwise the first of the
# candidates that exists. Which one was used is always logged, because "why does
# my session behave differently from my Casper shell" has to be answerable.
# ---------------------------------------------------------------------------
# 0. Fetch the published CIRRUS kubeconfig into ~/.kube/cirrus-config.
#
# CIRRUS publishes the current container-friendly kubeconfig to object storage.
# It used to be baked into the image instead, which went stale the first time a
# cluster CA rotated: every session built from that image then failed TLS until
# someone regenerated the file and rebuilt. Fetched here, a rotation needs a new
# object in the bucket and nothing else.
#
# At launch rather than at build time because the endpoint is only reachable on
# the UCAR network, which a CI builder is not on and a session pod is.
#
# ~/.kube/cirrus-config is the one file in the shared home this writes, and it
# is safe to: Casper and Derecho read ~/.kube/config, never this. A copy that
# differs from the published one -- most likely a stale one from an earlier
# rotation -- is moved aside with a timestamp rather than overwritten, so nothing
# a user put there is lost. If the home cannot be written, the copy lands in the
# session state dir, which cirrus-kubeconfig-src also searches.
#
# Failure is a warning, not an error: whatever is already on disk is still
# searched, and step 2 reports clearly if that turns out to be nothing.
# CIRRUS_KUBECONFIG_URL= (empty) disables the fetch; an explicit
# CIRRUS_KUBECONFIG_SRC skips it, since nothing fetched would be read.
# ---------------------------------------------------------------------------
KUBECONFIG_URL="${CIRRUS_KUBECONFIG_URL-https://s3.k8s.ucar.edu:5443/cirrus-config/kubeconfig}"
HOME_KUBECONFIG="${HOME:-/root}/.kube/cirrus-config"
SESSION_KUBECONFIG="${CIRRUS_PUBLISHED_KUBECONFIG:-${STATE_DIR}/kube/cirrus-published.yaml}"
fetch_status="skipped"

fetch_published_kubeconfig() {
    local tmp err dest backup
    [ -n "$KUBECONFIG_URL" ] || { fetch_status="disabled (CIRRUS_KUBECONFIG_URL is empty)"; return 0; }
    [ -z "${CIRRUS_KUBECONFIG_SRC:-}" ] || { fetch_status="skipped (CIRRUS_KUBECONFIG_SRC is set)"; return 0; }

    mkdir -p -- "$(dirname -- "$SESSION_KUBECONFIG")"
    tmp="$(mktemp "${SESSION_KUBECONFIG}.XXXXXX")"
    # Bounded: off the UCAR network the name does not resolve and this returns at
    # once, but a filtered port would otherwise hang the whole session launch.
    local rc=0
    err="$(curl -fsS --connect-timeout 5 --max-time 20 --retry 2 \
               -o "$tmp" "$KUBECONFIG_URL" 2>&1)" || rc=$?
    if [ "$rc" -ne 0 ]; then
        rm -f -- "$tmp"
        warn "could not fetch the published CIRRUS kubeconfig from ${KUBECONFIG_URL}"
        warn "  ${err:-curl failed}"
        # 6/7/28: no DNS, no route, timed out -- what off-network looks like.
        case "$rc" in 6|7|28) warn "(that address is only reachable on the UCAR network)" ;; esac
        fetch_status="FAILED (${err:-curl failed})"
        return 0
    fi
    # A 200 that is not a kubeconfig -- an error page, an empty object -- must
    # not replace one that works.
    if ! yq -e '.kind == "Config" and ((.contexts // []) | length > 0)' "$tmp" >/dev/null 2>&1; then
        rm -f -- "$tmp"
        warn "${KUBECONFIG_URL} did not return a kubeconfig with any contexts; ignoring it"
        fetch_status="FAILED (not a kubeconfig)"
        return 0
    fi
    chmod 0600 -- "$tmp"

    dest="$HOME_KUBECONFIG"
    if ! mkdir -p -- "$(dirname -- "$dest")" 2>/dev/null || [ ! -w "$(dirname -- "$dest")" ] \
       || { [ -e "$dest" ] && [ ! -w "$dest" ]; }; then
        dest="$SESSION_KUBECONFIG"
    fi

    if [ -f "$dest" ] && cmp -s -- "$tmp" "$dest"; then
        rm -f -- "$tmp"
        fetch_status="${dest} is current"
        return 0
    fi
    if [ "$dest" = "$HOME_KUBECONFIG" ] && [ -e "$dest" ]; then
        backup="${dest}.bak.$(date +%Y%m%d-%H%M%S)"
        mv -f -- "$dest" "$backup"
        warn "${dest} differed from the published CIRRUS kubeconfig; moved it to ${backup}"
    fi
    mv -f -- "$tmp" "$dest"
    fetch_status="updated ${dest}"
    [ "$dest" = "$SESSION_KUBECONFIG" ] && fetch_status="${fetch_status} (${HOME_KUBECONFIG} is not writable)"
    return 0
}
fetch_published_kubeconfig

# Which kubeconfig to read is decided in exactly one place -- see
# cirrus-kubeconfig-src for the preference order and why it matters.
SRC="$(cirrus-kubeconfig-src)"
if [ -n "${CIRRUS_KUBECONFIG_SRC:-}" ]; then
    src_source="CIRRUS_KUBECONFIG_SRC"
elif [ "$SRC" = "$SESSION_KUBECONFIG" ]; then
    src_source="published CIRRUS kubeconfig, session copy (no usable kubeconfig in \$HOME)"
else
    src_source="default search"
fi
# `|| true` is load-bearing under `set -e -o pipefail`: with a single candidate
# the grep matches nothing, exits 1, and would take the whole bootstrap down --
# which is exactly what it did.
src_alternatives="$(cirrus-kubeconfig-src --all | grep -vxF -- "$SRC" | paste -sd', ' - || true)"

DST="${KUBECONFIG:-${STATE_DIR}/kube/config}"
# The name a workstation kubeconfig uses for the workshop cluster. Preferred
# when present, but never required -- see the context selection below.
WANT_CONTEXT="mlc1"

# Azure/kubelogin, not int128/kubelogin: the CIRRUS exec block is
#   kubelogin get-token --environment AzurePublicCloud --server-id ... --client-id ... --tenant-id ...
# Its headless login method is devicecode (which is also its default), and its
# cache flag is --cache-dir, defaulting to $HOME/.kube/cache/kubelogin.
LOGIN_METHOD="${CIRRUS_KUBELOGIN_LOGIN:-devicecode}"
CACHE_DIR="${CIRRUS_KUBELOGIN_CACHE_DIR:-${HOME:-/root}/.kube/cache/kubelogin}"

# The exec block is pointed at the caching wrapper rather than kubelogin
# itself. kubelogin's own token cache is libsecret-over-DBus on Linux, which a
# pod does not have, so without the wrapper every single kubectl invocation
# starts a fresh device-code sign-in. CIRRUS_TOKEN_CACHE=off keeps the plain
# binary. See cirrus-kubelogin for the details.
if [ "${CIRRUS_TOKEN_CACHE:-on}" = "off" ]; then
    EXEC_COMMAND="kubelogin"
else
    EXEC_COMMAND="cirrus-kubelogin"
fi

# ---------------------------------------------------------------------------
# 1. Reject a KUBECONFIG that is a merge list. kubectl accepts a :-separated
#    list and writes only to the first entry, so `set-context` would mutate one
#    file while reads came from all of them. Better to stop than to guess.
# ---------------------------------------------------------------------------
case "$DST" in
    *:*) die "KUBECONFIG contains ':' and is being treated as a merge list: $DST" \
             "kubectl writes only to the first entry of such a list, which makes" \
             "this bootstrap's mutations land somewhere the session does not read." \
             "Set KUBECONFIG to a single writable path (default ${STATE_DIR}/kube/config)." ;;
esac

# ---------------------------------------------------------------------------
# 1b. Refuse a destination that cannot hold a kubeconfig.
#
# OOD sets KUBECONFIG=/dev/null in the session pod. Honouring that writes the
# copy into the bit bucket, leaves kubectl with an empty config, and -- because
# client-go falls back to the pod's service account when it finds no usable
# config -- produces
#
#   Error from server (Forbidden): pods is forbidden: User
#   "system:serviceaccount:ood-<user>:default" cannot list resource "pods"
#
# which names an identity the user has never heard of. A character device, a
# directory or a socket is not a mistake to propagate: the whole job here is to
# produce a kubeconfig, so fall back to a path that can hold one and say so.
if [ -e "$DST" ] && [ ! -f "$DST" ]; then
    warn "KUBECONFIG=${DST} is not a regular file and cannot hold a kubeconfig."
    DST="${STATE_DIR}/kube/config"
    warn "Using ${DST} instead. Everything in this session that reads KUBECONFIG"
    warn "must see that path -- export it, or re-run this from the entrypoint."
    KUBECONFIG="$DST"
    export KUBECONFIG
fi

# ---------------------------------------------------------------------------
# 2. The source config must already exist. Synthesising one would mean
#    inventing a cluster CA and an app registration, and the failure would
#    surface much later as an unexplained TLS or auth error.
# ---------------------------------------------------------------------------
if [ ! -f "$SRC" ]; then
    die "no CIRRUS kubeconfig found for this session" \
        "Looked for, in order: $(cirrus-kubeconfig-src --candidates | paste -sd' ' -)" \
        "Fetching the published one from ${KUBECONFIG_URL:-<disabled>}: ${fetch_status}" \
        "" \
        "\$HOME/.kube/cirrus-config is the one that works in a container: mlc1 and" \
        "nwc1 contexts, Azure kubelogin, and the CA embedded in the file rather" \
        "than referenced by a path that only exists on Casper and Derecho." \
        "" \
        "  - If you have never been issued one, request access from the CIRRUS team:" \
        "      $DOCS_URL" \
        "  - If yours is somewhere else, point CIRRUS_KUBECONFIG_SRC at it and re-run:" \
        "      CIRRUS_KUBECONFIG_SRC=/path/to/config $PROG"
fi
if [ ! -r "$SRC" ]; then
    die "CIRRUS kubeconfig is not readable: $SRC" \
        "Check the file mode and that your GLADE home is mounted in this session."
fi

# ---------------------------------------------------------------------------
# 3. Refuse to write to the source. Compared by resolved path *and* by
#    device:inode, so a symlink, a bind mount, or a ~ that expanded differently
#    cannot slip past a string comparison. This is the guard that keeps a
#    well-meant KUBECONFIG override in submit.yml.erb from turning this script
#    into an in-place rewrite of a file the user's HPC sessions depend on.
# ---------------------------------------------------------------------------
dst_dir="$(dirname -- "$DST")"
mkdir -p -- "$dst_dir"

src_real="$(readlink -f -- "$SRC" 2>/dev/null || printf '%s' "$SRC")"
dst_real="$(readlink -f -- "$DST" 2>/dev/null || printf '%s' "$DST")"

# Nor anywhere else in the shared ~/.kube. A KUBECONFIG exported by the user's
# dotfiles (~/.kube/capsule-config, say) is not the source, so the check below
# would let this overwrite it -- in a directory Casper and Derecho read.
home_kube="$(readlink -f -- "${HOME:-/root}/.kube" 2>/dev/null || printf '%s' "${HOME:-/root}/.kube")"
case "$dst_real" in
    "$home_kube"/*)
        die "KUBECONFIG points into your home directory: $DST" \
            "This writes a rewritten copy of the kubeconfig to \$KUBECONFIG, and a file" \
            "under ${home_kube} is shared with your Casper and Derecho sessions." \
            "It is probably exported by your shell startup files. For this shell:" \
            "  export KUBECONFIG=${CIRRUS_SESSION_KUBECONFIG:-${STATE_DIR}/kube/config}" ;;
esac

same_file=0
[ "$src_real" = "$dst_real" ] && same_file=1
if [ -e "$DST" ]; then
    src_id="$(stat -c '%d:%i' -- "$SRC" 2>/dev/null || true)"
    dst_id="$(stat -c '%d:%i' -- "$DST" 2>/dev/null || true)"
    [ -n "$src_id" ] && [ "$src_id" = "$dst_id" ] && same_file=1
fi
if [ "$same_file" -eq 1 ]; then
    die "KUBECONFIG and CIRRUS_KUBECONFIG_SRC resolve to the same file" \
        "  CIRRUS_KUBECONFIG_SRC : $SRC  -> $src_real" \
        "  KUBECONFIG            : $DST  -> $dst_real" \
        "" \
        "That would rewrite the kubeconfig your Casper and Derecho sessions share." \
        "KUBECONFIG must name a separate, session-local path" \
        "(default ${STATE_DIR}/kube/config)."
fi

# ---------------------------------------------------------------------------
# 4. Copy, 0600. Everything after this point touches only the copy.
# ---------------------------------------------------------------------------
install -m 0600 -- "$SRC" "$DST"

# ---------------------------------------------------------------------------
# 5. Namespace. CIRRUS_NAMESPACE comes from submit.yml.erb as ood-<%= user %>:
#    OOD knows the authenticated username with certainty and the container does
#    not, so an inferred value is a fallback and says so.
# ---------------------------------------------------------------------------
NAMESPACE="${CIRRUS_NAMESPACE:-}"
ns_source="CIRRUS_NAMESPACE (from the OOD pod spec)"
if [ -z "$NAMESPACE" ]; then
    # $USER first, then $LOGNAME: with an arbitrary uid and no /etc/passwd entry
    # those come from the pod spec and mean something, while `id -un` falls back
    # to printing the uid *as a number* and exiting 0. "ood-54321" is not a
    # namespace anyone has, so a numeric answer is rejected rather than used.
    # Last resort is the leaf of $HOME, which on GLADE is the username.
    who=""
    for candidate in "${USER:-}" "${LOGNAME:-}" "$(id -un 2>/dev/null || true)" "$(basename -- "${HOME:-}" 2>/dev/null || true)"; do
        case "$candidate" in
            ''|/|.|*[!a-zA-Z0-9._-]*) continue ;;   # empty, a path, or not name-shaped
            *[!0-9]*) who="$candidate"; break ;;    # has a non-digit: a real name
            *) continue ;;                          # all digits: a failed uid lookup
        esac
    done
    [ -n "$who" ] || die "CIRRUS_NAMESPACE is unset and the username could not be determined" \
        "id -un, \$USER, \$LOGNAME and \$HOME all came up empty, so there is no" \
        "way to guess which ood-<user> namespace this session belongs to." \
        "Set it explicitly:  CIRRUS_NAMESPACE=ood-<your-username> $PROG"
    NAMESPACE="ood-${who}"
    ns_source="INFERRED from ${who}"
    warn "CIRRUS_NAMESPACE was not set by the OOD pod spec."
    warn "Falling back to an inferred namespace: ${NAMESPACE}"
    warn "If that is not your namespace, nothing in this session will be authorized."
fi

# A namespace must be a DNS-1123 label. Normalising a bad value silently would
# point the session at a namespace the user has no access to, and the error
# would surface as a confusing Forbidden much later.
if ! printf '%s' "$NAMESPACE" | grep -Eq '^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$'; then
    die "namespace is not a valid DNS-1123 label: '${NAMESPACE}'" \
        "Source: ${ns_source}" \
        "A namespace must be 1-63 characters of [a-z0-9-], starting and ending" \
        "with an alphanumeric. Usernames with capitals, dots or underscores do" \
        "not map to a namespace by themselves -- set CIRRUS_NAMESPACE explicitly."
fi

# ---------------------------------------------------------------------------
# 6. Context.
#
# There are two shapes of CIRRUS kubeconfig in the wild and they do not agree on
# names. A workstation config has one context per cluster (mlc1, nwc1, ...). The
# config OOD users get in their GLADE home has a single context named `cirrus`
# with an ood-user-<name> authinfo. Requiring the literal name "mlc1" works for
# the first and can never match the second.
#
# So: an explicit CIRRUS_CONTEXT wins and is required to exist; otherwise prefer
# mlc1 when it is there; otherwise, if the file offers exactly one context, that
# is not a guess and it is used -- with the cluster and server logged, because
# "which cluster am I on" must stay answerable. Several contexts and no mlc1 is
# genuinely ambiguous and still stops, rather than running the labs against
# whichever cluster happened to sort first.
# ---------------------------------------------------------------------------
mapfile -t available_contexts < <(kubectl --kubeconfig "$DST" config get-contexts -o name 2>/dev/null)
available_list="$(printf '%s ' "${available_contexts[@]+"${available_contexts[@]}"}" | sed 's/ $//')"

has_context() {
    local want="$1" c
    for c in ${available_contexts[@]+"${available_contexts[@]}"}; do
        [ "$c" = "$want" ] && return 0
    done
    return 1
}

CONTEXT=""
context_source=""
if [ -n "${CIRRUS_CONTEXT:-}" ]; then
    if has_context "$CIRRUS_CONTEXT"; then
        CONTEXT="$CIRRUS_CONTEXT"
        context_source="CIRRUS_CONTEXT"
    else
        die "no '${CIRRUS_CONTEXT}' context in $SRC (requested via CIRRUS_CONTEXT)" \
            "Contexts available in your kubeconfig: ${available_list:-<none>}" \
            "" \
            "Either fix CIRRUS_CONTEXT, or ask the CIRRUS team for a kubeconfig that" \
            "includes it:" \
            "  $DOCS_URL"
    fi
elif has_context "$WANT_CONTEXT"; then
    CONTEXT="$WANT_CONTEXT"
    context_source="the workshop default"
elif [ "${#available_contexts[@]}" -eq 1 ]; then
    CONTEXT="${available_contexts[0]}"
    context_source="the only context in your kubeconfig"
elif [ "${#available_contexts[@]}" -eq 0 ]; then
    die "no contexts at all in $SRC" \
        "The file exists but defines no contexts, so there is nothing to connect to." \
        "Ask the CIRRUS team for a working kubeconfig:" \
        "  $DOCS_URL"
else
    die "no '${WANT_CONTEXT}' context in $SRC, and more than one to choose from" \
        "Contexts available in your kubeconfig: ${available_list}" \
        "" \
        "Rather than picking one for you and running the labs against the wrong" \
        "cluster, this stops here. Name the one you want:" \
        "  CIRRUS_CONTEXT=<context> $PROG" \
        "  $DOCS_URL"
fi

kubectl --kubeconfig "$DST" config use-context "$CONTEXT" >/dev/null
kubectl --kubeconfig "$DST" config set-context --current --namespace "$NAMESPACE" >/dev/null

# ---------------------------------------------------------------------------
# 6b. Host paths that only exist on Casper and Derecho.
#
# The kubeconfig CIRRUS issues for the HPC systems refers to files by absolute
# path -- a CA at /etc/pki/tls/certs/cirrus-ca.crt and a credential plugin at
# /opt/ncar/sbin/get-cirrus-token.sh. Neither exists in a container, and kubectl
# reports each as a bare open() failure that says nothing about why.
#
# The CA is recoverable: an OOD session pod runs *on* a CIRRUS cluster, so the
# cluster's own CA is mounted at the service-account path. Substituting it is
# correct whenever the kubeconfig names the cluster this pod is running on, and
# when it does not, TLS fails with a certificate error instead of a missing-file
# error -- no worse off, and much easier to read. CIRRUS_KUBECONFIG_CA_FALLBACK=off
# disables the substitution.
#
# The credential plugin is not recoverable from inside the pod, so it is reported
# rather than worked around.
# ---------------------------------------------------------------------------
INCLUSTER_CA="${CIRRUS_INCLUSTER_CA:-/var/run/secrets/kubernetes.io/serviceaccount/ca.crt}"
cluster_name="$(kubectl --kubeconfig "$DST" config view --minify -o jsonpath='{.clusters[0].name}' 2>/dev/null)"
ca_file="$(C="$cluster_name" yq '.clusters[] | select(.name == strenv(C)) | .cluster."certificate-authority" // ""' "$DST" 2>/dev/null || true)"

if [ -n "$ca_file" ] && [ ! -r "$ca_file" ]; then
    warn "the kubeconfig's CA file does not exist in this container: ${ca_file}"
    warn "(that path is on Casper and Derecho, not in an image)"
    if [ "${CIRRUS_KUBECONFIG_CA_FALLBACK:-auto}" != "off" ] && [ -r "$INCLUSTER_CA" ]; then
        C="$cluster_name" CA="$INCLUSTER_CA" yq -i \
            '(.clusters[] | select(.name == strenv(C)) | .cluster."certificate-authority") = strenv(CA)' "$DST"
        warn "substituted this pod's own cluster CA: ${INCLUSTER_CA}"
        warn "That is the right CA if this kubeconfig names the cluster this session"
        warn "runs on. If it names a different one, expect a TLS error rather than this."
        ca_status="substituted ${INCLUSTER_CA}"
    else
        warn "no in-cluster CA available to substitute, so TLS will fail."
        warn "Ask the CIRRUS team for a kubeconfig with embedded"
        warn "certificate-authority-data, which needs no files on disk."
        ca_status="MISSING ${ca_file}"
    fi
else
    ca_status="ok"
fi

# ---------------------------------------------------------------------------
# 7/8. Rewrite the kubelogin exec block for a headless session.
#
# There is no browser in this container, so a login method that wants to open
# one and catch a localhost redirect cannot work. Azure kubelogin's headless
# method is devicecode: it prints a URL and a code to the terminal and polls.
# (int128/kubelogin's --grant-type=authcode-keyboard is the equivalent for the
# other kubelogin; this cluster does not use that one.)
#
# --cache-dir is pointed at the user's real ~/.kube/cache/kubelogin so an
# unexpired token from their HPC session is reused and they are not made to
# authenticate again. This is the one intentional write into the shared home,
# and CIRRUS_KUBELOGIN_CACHE_DIR redirects it if that ever causes trouble.
#
# Edited with yq, per key -- a sed over a YAML args list would be one
# reformatted config away from silently mangling the file.
# ---------------------------------------------------------------------------
if ! mkdir -p -- "$CACHE_DIR" 2>/dev/null; then
    warn "could not create the kubelogin token cache at ${CACHE_DIR}"
    CACHE_DIR="${STATE_DIR}/kube/cache/kubelogin"
    warn "using a session-local cache instead: ${CACHE_DIR} (you will have to log in again)"
    mkdir -p -- "$CACHE_DIR"
fi

rewrote_exec=0
while IFS= read -r user_name; do
    [ -n "$user_name" ] || continue

    # Existing args, one per line. None of these flags or values contain
    # whitespace, so line-splitting is safe here.
    mapfile -t old_args < <(U="$user_name" yq '.users[] | select(.name == strenv(U)) | .user.exec.args[]' "$DST")

    new_args=()
    skip_next=0
    for arg in "${old_args[@]}"; do
        if [ "$skip_next" -eq 1 ]; then skip_next=0; continue; fi
        case "$arg" in
            -l|--login|--cache-dir)   skip_next=1; continue ;;
            --login=*|--cache-dir=*)  continue ;;
        esac
        new_args+=("$arg")
    done
    new_args+=(--login "$LOGIN_METHOD" --cache-dir "$CACHE_DIR")

    args_nl="$(printf '%s\n' "${new_args[@]}")"
    U="$user_name" ARGS="$args_nl" yq -i \
        '(.users[] | select(.name == strenv(U)) | .user.exec.args) = (strenv(ARGS) | split("\n"))' "$DST"

    # kubectl only hands the plugin a terminal when the exec block says it may
    # need one, and device code always does.
    U="$user_name" yq -i \
        '(.users[] | select(.name == strenv(U)) | .user.exec.interactiveMode) = "IfAvailable"' "$DST"

    U="$user_name" C="$EXEC_COMMAND" yq -i \
        '(.users[] | select(.name == strenv(U)) | .user.exec.command) = strenv(C)' "$DST"

    rewrote_exec=$((rewrote_exec + 1))
done < <(yq '.users[] | select((.user.exec.command // "") | test("kubelogin$")) | .name' "$DST")

exec_command="$(kubectl --kubeconfig "$DST" config view --minify -o jsonpath='{.users[0].user.exec.command}' 2>/dev/null)"
plugin_status="ok"
if [ "$rewrote_exec" -eq 0 ]; then
    warn "no kubelogin exec block found in $SRC -- left the credential plugin untouched."
fi
if [ -n "$exec_command" ]; then
    case "$exec_command" in
        /*) [ -x "$exec_command" ] || plugin_status="MISSING ${exec_command}" ;;
        *)  command -v "$exec_command" >/dev/null 2>&1 || plugin_status="NOT ON PATH ${exec_command}" ;;
    esac
fi
if [ "$plugin_status" != "ok" ]; then
    warn "the credential plugin this kubeconfig names cannot run here: ${exec_command}"
    warn "(an /opt/ncar path exists on Casper and Derecho, not in a container)"
    warn "Nothing in this session can authenticate until that is resolved. The"
    warn "kubeconfig CIRRUS issues for workstations uses Azure kubelogin instead,"
    warn "which this image ships:"
    warn "  $DOCS_URL"
fi

chmod 0600 "$DST"

# ---------------------------------------------------------------------------
# 9. Summary.
# ---------------------------------------------------------------------------
context="$(kubectl --kubeconfig "$DST" config current-context)"
cluster="$(kubectl --kubeconfig "$DST" config view --minify -o jsonpath='{.clusters[0].name}' 2>/dev/null || true)"
server="$(kubectl --kubeconfig "$DST" config view --minify -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null || true)"

log "session kubeconfig ready"
log "  source (read-only) : $SRC"
log "  session copy       : $DST"
log "  context            : $context  [${context_source}]"
log "  cluster            : ${cluster:-unknown} (${server:-unknown})"
log "  namespace          : $NAMESPACE  [${ns_source}]"
log "  source selected by : ${src_source}${src_alternatives:+ (also present: ${src_alternatives})}"
log "  published config   : ${fetch_status}"
if [ "$rewrote_exec" -gt 0 ]; then
    log "  identity           : Azure kubelogin, --login ${LOGIN_METHOD}, cache ${CACHE_DIR}"
fi
log "  credential plugin  : ${exec_command:-<none>}$([ "$plugin_status" = "ok" ] && [ "$EXEC_COMMAND" = "cirrus-kubelogin" ] && printf ' (session token cache)')"
log "  cluster CA         : ${ca_status}"
if [ "$plugin_status" != "ok" ]; then
    log "  NOTE: credential plugin ${plugin_status} -- this session cannot authenticate yet."
fi
if [ "$LOGIN_METHOD" = "devicecode" ] && [ "$rewrote_exec" -gt 0 ] && [ "$plugin_status" = "ok" ]; then
    log "  first kubectl call in a terminal will print a URL and a code to sign in with."
    if [ "$EXEC_COMMAND" = "cirrus-kubelogin" ]; then
        log "  that token is then reused for the rest of the session, until it expires."
    else
        log "  CIRRUS_TOKEN_CACHE=off: EVERY kubectl call will ask you to sign in again."
    fi
fi
