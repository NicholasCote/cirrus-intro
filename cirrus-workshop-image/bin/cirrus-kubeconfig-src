#!/usr/bin/env bash
#
# Print which kubeconfig this session should read from.
#
# One place for this decision. It used to be spelled out in the entrypoint, in
# /etc/profile.d/cirrus.sh, in cirrus-check and in cirrus-kubeconfig-init -- and
# the entrypoint's copy defaulted to ~/.kube/config, which silently beat the
# newer search in the bootstrap. Four copies, one of them wrong, and the symptom
# was a session using the Casper kubeconfig while claiming the operator had
# chosen it.
#
#   cirrus-kubeconfig-src               the one to use
#   cirrus-kubeconfig-src --all         every candidate that exists, one per line
#   cirrus-kubeconfig-src --candidates  every candidate searched, existing or not
#
# Preference order, and why: ~/.kube/cirrus-config is the container-friendly
# config (mlc1 + nwc1, Azure kubelogin, CA embedded in the file), and
# cirrus-kubeconfig-init refreshes it from the published copy at every launch.
# ~/.kube/config is the one CIRRUS issues for Casper and Derecho, which refers to
# /etc/pki/tls/certs/cirrus-ca.crt and /opt/ncar/sbin/get-cirrus-token.sh by
# absolute path -- both real on those hosts, neither present in any container.
# Last is the session-local copy of the published config, which only exists when
# the home could not be written.

set -uo pipefail

SESSION_KUBECONFIG="${CIRRUS_PUBLISHED_KUBECONFIG:-${CIRRUS_STATE_DIR:-/tmp/cirrus}/kube/cirrus-published.yaml}"
CANDIDATES="${CIRRUS_KUBECONFIG_CANDIDATES:-${HOME:-/root}/.kube/cirrus-config:${HOME:-/root}/.kube/config:${SESSION_KUBECONFIG}}"

# Order alone is not enough. A user whose only kubeconfig is the Casper/Derecho
# one -- CA at /etc/pki, plugin at /opt/ncar -- would get a file that cannot
# authenticate here, while the published one can. So candidates are
# ranked by whether they are actually usable *in this container*, and order
# breaks ties. Nothing is rewritten and nothing is preferred over a user's own
# working config; this only stops an unusable file from winning on position.
kubeconfig_is_usable() {
    local file="$1" line
    [ -f "$file" ] || return 1
    command -v yq >/dev/null 2>&1 || return 0   # cannot judge; do not veto
    yq -e '(.contexts // []) | length > 0' "$file" >/dev/null 2>&1 || return 1

    # A CA given as a path has to exist here. An embedded one always does.
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        [ -r "$line" ] || return 1
    done < <(yq '.clusters[]?.cluster."certificate-authority" // ""' "$file" 2>/dev/null)

    # A credential plugin has to be runnable here.
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        case "$line" in
            /*) [ -x "$line" ] || return 1 ;;
            *)  command -v "$line" >/dev/null 2>&1 || return 1 ;;
        esac
    done < <(yq '.users[]?.user.exec.command // ""' "$file" 2>/dev/null)

    return 0
}

if [ "${1:-}" = "--candidates" ]; then
    printf '%s\n' "$CANDIDATES" | tr ':' '\n'
    exit 0
fi

# An explicit setting is a decision, not a guess: honour it and stop.
if [ -n "${CIRRUS_KUBECONFIG_SRC:-}" ]; then
    printf '%s\n' "$CIRRUS_KUBECONFIG_SRC"
    exit 0
fi

found=""
old_ifs="$IFS"
IFS=":"
for candidate in $CANDIDATES; do
    [ -n "$candidate" ] || continue
    if [ -f "$candidate" ]; then
        found="${found}${candidate}"$'\n'
    fi
done
IFS="$old_ifs"

if [ "${1:-}" = "--all" ]; then
    printf '%s' "$found"
    exit 0
fi

if [ -n "$found" ]; then
    # First usable, else first present -- so diagnostics still name the user's own
    # file when nothing at all can work.
    while IFS= read -r candidate; do
        [ -n "$candidate" ] || continue
        if kubeconfig_is_usable "$candidate"; then
            printf '%s\n' "$candidate"
            exit 0
        fi
    done <<< "$found"
    printf '%s\n' "$found" | head -1
else
    # Nothing exists yet. Name the preferred path anyway, so callers report a
    # real place to put a file rather than an empty string.
    printf '%s\n' "${CANDIDATES%%:*}"
fi
